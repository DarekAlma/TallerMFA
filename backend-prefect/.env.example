# Copia este archivo como .env y completa los valores.

# --- Supabase (Project Settings > API Keys) ---
# URL del proyecto: https://<ref>.supabase.co
SUPABASE_URL=
# Llave SECRETA (sb_secret_...) o la legacy "service_role". ¡Nunca en el frontend!
SUPABASE_SERVICE_KEY=
# Si SUPABASE_URL queda vacío se usa SQLite local (local.db)

# --- JWT ---
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
PRE_AUTH_TTL_SECONDS=300
ACCESS_TTL_SECONDS=900
MAX_MFA_ATTEMPTS=5

# --- TOTP ---
TOTP_ISSUER=TallerMFA
ANTI_REPLAY_TTL_SECONDS=90
BACKUP_CODES_COUNT=8
# Opcional: llave Fernet para cifrar la semilla TOTP en la BD
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- Prefect (servidor local: prefect server start) ---
PREFECT_API_URL=http://127.0.0.1:4200/api

# --- CORS: orígenes permitidos (coma). Ej: http://localhost:5173,https://tu-app.vercel.app
CORS_ORIGINS=*
